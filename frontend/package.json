{
  "name": "scroll-mood-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Scroll Mood dashboard (Electron + React)",
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:api": "cross-env VITE_DATA_SOURCE=api electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "dev:realistic": "cross-env VITE_MOCK_FILE=realistic electron-vite dev",
    "dev:live": "cross-env VITE_MOCK_FILE=live electron-vite dev",
    "dev:empty": "cross-env VITE_MOCK_FILE=none electron-vite dev",
    "dev:no-samples": "cross-env VITE_MOCK_FILE=edge/no-samples electron-vite dev",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "geist": "^1.9.2",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "simple-icons": "^16.36.0"
  }
}
