# mock | api  (override with `npm run dev:api`)
VITE_DATA_SOURCE=mock

# Which files in src/mock/ to read: all (default) | none | comma-separated names without extension
# e.g. realistic   events,live   edge/no-samples
VITE_MOCK_FILE=all

# Scroll Circle (share progress via a Discord webhook). Hidden unless true. See src/config/features.ts.
VITE_ENABLE_CIRCLE=false
