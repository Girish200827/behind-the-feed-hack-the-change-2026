---
const bullets = [
  {
    label: "Health",
    body: "Catches the invisible mood dips that build up during long scroll sessions, before they become the norm.",
  },
  {
    label: "Well-being",
    body: "Turns scrolling from a passive habit into a reflective one, with a session report instead of a void.",
  },
  {
    label: "Social connection",
    body: "Once you see which feeds drain you, it's easier to close the app and be present with people instead.",
  },
];
---

<section class="section answer">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">The prompt</p>
      <h2>"How can we leverage technology to promote health, social connection, and well-being
      in our communities?"</h2>
    </div>

    <div class="card answer-card" data-reveal>
      <h3 class="answer-title">How BehindFeed answers it</h3>
      <ul class="answer-list" data-reveal-stagger>
        {
          bullets.map((b) => (
            <li>
              <span class="answer-label">{b.label}</span>
              <span class="answer-body">{b.body}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .answer-card {
    max-width: 760px;
    margin: 0 auto;
  }

  .answer-title {
    margin-bottom: 1.25rem;
  }

  .answer-list {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .answer-list li {
    display: flex;
    gap: 1rem;
    align-items: baseline;
  }

  .answer-label {
    flex-shrink: 0;
    width: 7.5rem;
    font-weight: 600;
    color: var(--accent-blue);
    font-size: 0.9rem;
  }

  .answer-body {
    color: var(--muted);
  }

  @media (max-width: 600px) {
    .answer-list li {
      flex-direction: column;
      gap: 0.25rem;
    }
    .answer-label {
      width: auto;
    }
  }
</style>
